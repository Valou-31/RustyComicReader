<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>rusty_comic_reader</string>
    <key>CFBundleIconFile</key>
    <string>icon.icns</string>
    <key>CFBundleIdentifier</key>
    <string>com.rustycomicreader.app</string>
    <key>CFBundleName</key>
    <string>Comic Reader</string>
    <key>CFBundleDisplayName</key>
    <string>Comic Reader</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>APP_VERSION</string>
    <key>CFBundleVersion</key>
    <string>APP_VERSION</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Comic Reader</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Comic Book Archive (CBZ)</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.rustycomicreader.cbz</string>
                <string>public.zip-archive</string>
            </array>
            <!-- Legacy extension-based fallback alongside the UTI declaration
                 above — matches by raw extension without needing to "own"
                 any UTI, so it isn't affected by another app's exported UTI
                 winning the extension's system-wide UTI-ownership
                 arbitration (macOS only keeps one "active" exported UTI per
                 extension at a time; a rival app's own custom UTI for .cbz
                 can end up as that winner, silently demoting ours). -->
            <key>CFBundleTypeExtensions</key>
            <array><string>cbz</string></array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Comic Book Archive (CB7)</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.rustycomicreader.cb7</string>
                <string>org.7-zip.7-zip-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array><string>cb7</string></array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Comic Book Archive (CBR)</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.rustycomicreader.cbr</string>
                <string>com.rarlab.rar-archive</string>
            </array>
            <key>CFBundleTypeExtensions</key>
            <array><string>cbr</string></array>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.rustycomicreader.cbz</string>
            <key>UTTypeDescription</key>
            <string>Comic Book Archive (CBZ)</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.zip-archive</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>cbz</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.rustycomicreader.cb7</string>
            <key>UTTypeDescription</key>
            <string>Comic Book Archive (CB7)</string>
            <key>UTTypeConformsTo</key>
            <array><string>org.7-zip.7-zip-archive</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>cb7</string></array>
            </dict>
        </dict>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.rustycomicreader.cbr</string>
            <key>UTTypeDescription</key>
            <string>Comic Book Archive (CBR)</string>
            <key>UTTypeConformsTo</key>
            <array><string>com.rarlab.rar-archive</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>cbr</string></array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
